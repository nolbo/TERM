  * Directory renames retain the existing syscall exit processing. */
-static int translate_rename_path(Tracee *tracee, int dirfd, char path[PATH_MAX], Reg reg)
+/* Only these non-USERLAND callbacks leave rename arguments untouched at
+ * SYSCALL_ENTER_END. Other extensions need translated strings in guest memory. */
+static bool rename_local_enabled(Tracee *tracee)
+{
+#ifdef USERLAND
+	return false;
+#else
+	const char *setting = getenv("PROOT_RENAME_LOCAL");
+	if (!setting || strcmp(setting, "1") != 0) return false;
+	Extension *extension;
+	if (tracee->extensions)
+		LIST_FOREACH(extension, tracee->extensions, link)
+			if (extension->callback != fake_id0_callback && extension->callback != mountinfo_callback)
+				return false;
+	return true;
+#endif
+}
+
+static int translate_rename_path(Tracee *tracee, int dirfd, char path[PATH_MAX], Reg reg, bool local)
 {
 	if (!path[0]) return 0;
 	char translated[PATH_MAX];
 	int status = translate_path(tracee, translated, dirfd, path, false);
 	if (status < 0) return status;
-	status = set_sysarg_path(tracee, translated, reg);
+	if (!local) status = set_sysarg_path(tracee, translated, reg);
 	if (status >= 0) strcpy(path, translated);
 	return status;
 }
