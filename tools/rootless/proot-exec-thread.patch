+/**
+ * Select the task whose exec changed its kernel TID to @pid. The event
+ * message is the authoritative former TID; do not reuse the old leader's
+ * unrelated register cache, pending syscall or ELF load state.
+ */
+Tracee *exec_tracee(pid_t pid)
+{
+	unsigned long former = 0;
+	if (ptrace(PTRACE_GETEVENTMSG, pid, NULL, &former) < 0) {
+		note(NULL, ERROR, SYSTEM, "ptrace(GETEVENTMSG) at exec");
+		return NULL;
+	}
+	if (former == (unsigned long)pid)
+		return get_tracee(NULL, pid, true);
+	Tracee *executing = get_tracee(NULL, (pid_t)former, false);
+	if (executing == NULL) {
+		note(NULL, ERROR, INTERNAL, "unknown exec former tid %lu for pid %d", former, pid);
+		return NULL;
+	}
+	Tracee *leader = get_tracee(executing, pid, false);
+	if (leader != NULL) {
+		Tracee *relative;
+		executing->vpid = leader->vpid;
+		executing->parent = leader->parent;
+		executing->clone = leader->clone;
+		executing->killall_on_exit |= leader->killall_on_exit;
+		LIST_FOREACH(relative, &tracees, link)
+			if (relative->parent == leader)
+				relative->parent = executing;
+		/* Bindings created by the process live through its leader change. */
+		talloc_steal(executing->life_context, leader->life_context);
+		leader->life_context = NULL;
+		/* The kernel already destroyed this task. Remove its record
+		 * without applying the policy for a terminating process. */
+		TALLOC_FREE(leader);
+	}
+	executing->pid = pid;
+	VERBOSE(executing, 1, "exec former tid %lu now pid %d", former, pid);
+	return executing;
 }
 
