--- a/src/syscall/seccomp.c
+++ b/src/syscall/seccomp.c
@@ -253,7 +253,7 @@
  *
  * This function returns -errno if an error occurred, otherwise 0.
  */
-static int set_seccomp_filters(const FilteredSysnum *sysnums)
+static int set_seccomp_filters(const FilteredSysnum *sysnums, bool fd_utimens_direct)
 {
 	SeccompArch seccomp_archs[] = SECCOMP_ARCHS;
 	size_t nb_archs = sizeof(seccomp_archs) / sizeof(SeccompArch);
@@ -266,6 +266,30 @@
 	status = new_program_filter(&program);
 	if (status < 0)
 		goto end;
+
+#if defined(__aarch64__) && !defined(USERLAND)
+	/* futimens uses utimensat(fd, NULL, times, flags): a real kernel FD,
+	 * no guest path, no identity/metadata fixup in the supported extensions.
+	 * The kernel keeps pointer/flag/permission validation and guest filters.
+	 * Check both pointer halves; an unmapped high address is not NULL. */
+	if (fd_utimens_direct) {
+		struct sock_filter direct[] = {
+			BPF_STMT(BPF_LD+BPF_W+BPF_ABS, offsetof(struct seccomp_data, arch)),
+			BPF_JUMP(BPF_JMP+BPF_JEQ+BPF_K, AUDIT_ARCH_AARCH64, 0, 7),
+			BPF_STMT(BPF_LD+BPF_W+BPF_ABS, offsetof(struct seccomp_data, nr)),
+			BPF_JUMP(BPF_JMP+BPF_JEQ+BPF_K, 88 /* utimensat */, 0, 5),
+			BPF_STMT(BPF_LD+BPF_W+BPF_ABS, offsetof(struct seccomp_data, args) + 12),
+			BPF_JUMP(BPF_JMP+BPF_JEQ+BPF_K, 0, 0, 3),
+			BPF_STMT(BPF_LD+BPF_W+BPF_ABS, offsetof(struct seccomp_data, args) + 8),
+			BPF_JUMP(BPF_JMP+BPF_JEQ+BPF_K, 0, 0, 1),
+			BPF_STMT(BPF_RET+BPF_K, SECCOMP_RET_ALLOW),
+		};
+		status = add_statements(&program, sizeof(direct)/sizeof(direct[0]), direct);
+		if (status < 0) goto end;
+	}
+#else
+	(void)fd_utimens_direct;
+#endif
 
 #if defined(__aarch64__)
 	/* Experimental dispatcher: exact architecture, exact SVC return PC,
@@ -660,7 +684,18 @@
 		}
 	}
 
-	status = set_seccomp_filters(filtered_sysnums);
+	/* Unknown extensions and USERLAND retain normal tracing. */
+	const char *fd_utimens = getenv("PROOT_FD_UTIMENS_DIRECT");
+	bool fd_utimens_direct = fd_utimens && !strcmp(fd_utimens, "1");
+	if (tracee->extensions != NULL) {
+		LIST_FOREACH(extension, tracee->extensions, link) {
+			if (extension->callback != fake_id0_callback &&
+			    extension->callback != mountinfo_callback &&
+			    extension->callback != link2symlink_callback)
+				fd_utimens_direct = false;
+		}
+	}
+	status = set_seccomp_filters(filtered_sysnums, fd_utimens_direct);
 	if (status < 0)
 		return status;
 
