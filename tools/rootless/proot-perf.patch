--- /dev/null
+++ b/src/tracee/perf.c
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "tracee/perf.h"
+bool proot_perf_enabled;
+bool proot_path_fastpath_enabled = true;
+uint64_t proot_perf_counters[PERF_COUNT];
+static pid_t owner;
+static void report(void)
+{
+	static const char *names[PERF_COUNT] = {
+		"enter_stop", "exit_stop", "path_translation", "canon_lstat",
+		"l2s_exit_lstat", "l2s_readlink", "read_string", "vm_read", "vm_write", "vm_fallback",
+		"path_fast_hit", "path_fast_miss"
+	};
+	if (!proot_perf_enabled || getpid() != owner) return;
+	fprintf(stderr, "proot-perf:");
+	for (int i = 0; i < PERF_COUNT; i++)
+		fprintf(stderr, " %s=%" PRIu64, names[i], proot_perf_counters[i]);
+	fputc('\n', stderr);
+}
+void proot_perf_init(void)
+{
+	const char *value = getenv("PROOT_PERF");
+	proot_perf_enabled = value != NULL && strcmp(value, "1") == 0;
+	proot_path_fastpath_enabled = getenv("PROOT_NO_PATH_FASTPATH") == NULL;
+	owner = getpid();
+	if (proot_perf_enabled) atexit(report);
+}
--- /dev/null
+++ b/src/tracee/perf.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef PROOT_PERF_H
+#define PROOT_PERF_H
+#include <stdbool.h>
+#include <stdint.h>
+typedef enum {
+	PERF_ENTER_STOP, PERF_EXIT_STOP, PERF_PATH_TRANSLATION, PERF_CANON_LSTAT,
+	PERF_L2S_LSTAT, PERF_L2S_READLINK, PERF_READ_STRING, PERF_VM_READ, PERF_VM_WRITE,
+	PERF_VM_FALLBACK, PERF_PATH_HIT, PERF_PATH_MISS, PERF_COUNT
+} ProotPerfCounter;
+extern bool proot_perf_enabled;
+extern bool proot_path_fastpath_enabled;
+extern uint64_t proot_perf_counters[PERF_COUNT];
+void proot_perf_init(void);
+static inline void proot_perf_count(ProotPerfCounter counter)
+{
+	if (proot_perf_enabled) proot_perf_counters[counter]++;
+}
+#endif
