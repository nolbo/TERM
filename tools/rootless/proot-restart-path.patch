+/* Linux ARM64 rewinds PC and restores x0 before the signal-delivery
+ * ptrace stop. Entry-only translation leaves other arguments pointing to
+ * injected host paths below the original SP; the signal frame may overwrite
+ * them and the restarted syscall would translate them a second time.
+ * Match the exact pending call before restoring its guest arguments. Do not
+ * change PC: the kernel must still decide SA_RESTART versus EINTR itself. */
+static int restore_entry_only_restart(Tracee *tracee)
+{
+#if defined(ARCH_ARM64)
+	static const Reg arguments[] = { SYSARG_1, SYSARG_2, SYSARG_3,
+		SYSARG_4, SYSARG_5, SYSARG_6 };
+	size_t i;
+	int status;
+	if (!tracee->entry_only_restart || !IS_IN_SYSENTER(tracee)
+	    || tracee->chain.syscalls != NULL || is_32on64_mode(tracee))
+		return 0;
+	status = fetch_regs(tracee);
+	if (status < 0) return status;
+	if (peek_reg(tracee, CURRENT, INSTR_POINTER) + SYSTRAP_SIZE !=
+	    peek_reg(tracee, MODIFIED, INSTR_POINTER) ||
+	    peek_reg(tracee, CURRENT, SYSARG_NUM) != peek_reg(tracee, MODIFIED, SYSARG_NUM) ||
+	    peek_reg(tracee, CURRENT, STACK_POINTER) != peek_reg(tracee, ORIGINAL, STACK_POINTER))
+		return 0;
+	for (i = 0; i < sizeof(arguments) / sizeof(arguments[0]); i++) {
+		if (peek_reg(tracee, CURRENT, arguments[i]) != peek_reg(tracee, MODIFIED, arguments[i]))
+			return 0;
+	}
+	tracee->restore_original_regs = false;
+	poke_reg(tracee, SYSARG_NUM, peek_reg(tracee, ORIGINAL, SYSARG_NUM));
+	for (i = 0; i < sizeof(arguments) / sizeof(arguments[0]); i++)
+		poke_reg(tracee, arguments[i], peek_reg(tracee, ORIGINAL, arguments[i]));
+	status = push_specific_regs(tracee, false);
+	if (status < 0) return status;
+	tracee->entry_only_restart = false;
+	VERBOSE(tracee, 3, "restored guest arguments before syscall restart");
+#else
+	(void) tracee;
+#endif
+	return 0;
+}
