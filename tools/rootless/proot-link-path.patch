+/* Linux rename between two names for one inode preserves both names.  The
+ * kernel sees two distinct symlink inodes, so ask it to rename the canonical
+ * source onto itself instead.  It still executes the real syscall (including
+ * seccomp and flag validation); no success result is predicted here. */
+static int preserve_same_backing_rename(Extension *extension, Reg source, Reg destination)
+{
+	Tracee *tracee = TRACEE(extension);
+	Link2SymlinkConfig *config = get_config(extension, false);
+	struct stat backing;
+	char path[PATH_MAX], final[PATH_MAX];
+	int status;
+
+	if (config == NULL || config->removal == NULL) return 0;
+	status = read_path(tracee, path, peek_reg(tracee, CURRENT, source));
+	if (status < 0) return status;
+	if (resolve_faked_hard_link(path, final) < 0 || lstat(final, &backing) < 0 ||
+	    !same_inode(&config->removal->backing, &backing)) return 0;
+	if (tracee->local_rename_old != NULL)
+		tracee->local_rename_new = tracee->local_rename_old;
+	else
+		poke_reg(tracee, destination, peek_reg(tracee, CURRENT, source));
+	talloc_free(config->removal);
+	config->removal = NULL;
+	return 0;
+}
+
+static int finish_removal(Extension *extension)
+{
+	Tracee *tracee = TRACEE(extension);
+	Link2SymlinkConfig *config = get_config(extension, false);
+	PendingRemoval *pending, *other;
+	struct stat alias, backing;
+	char final[PATH_MAX], replacement[PATH_MAX];
+	const char *name, *new_name;
+	ssize_t length;
+	int count, status = 0;
+
+	if (config == NULL || config->removal == NULL) return 0;
+	pending = config->removal;
+	config->removal = NULL;
+	if (pending->owner != tracee->pid || pending->accounted ||
+	    (word_t)peek_reg(tracee, CURRENT, SYSARG_RESULT) != 0) goto out;
+	if (fstat(pending->alias_fd, &alias) < 0 || alias.st_nlink != 0) goto out;
+	/* Two tracees can have observed the same alias before either completed.
+	 * Only one removal owns its count, even if a replacement later allowed
+	 * the second syscall to succeed as well. */
+	for (other = pending_removals; other != NULL; other = other->next)
+		if (same_inode(&pending->alias, &other->alias)) other->accounted = true;
+	length = readlinkat(pending->directory_fd, pending->intermediate, final, sizeof(final) - 1);
+	if (length <= 0 || length >= (ssize_t)sizeof(final) - 1) goto out;
+	final[length] = '\0';
+	name = removal_entry(pending, final);
+	if (name == NULL || !is_l2s_file(final) ||
+	    fstatat(pending->directory_fd, name, &backing, AT_SYMLINK_NOFOLLOW) < 0 ||
+	    !same_inode(&pending->backing, &backing)) goto out;
+	count = atoi(final + strlen(final) - 4);
+	if (count <= 0) goto out;
+	if (count == 1) {
+		if (unlinkat(pending->directory_fd, pending->intermediate, 0) < 0 ||
+		    unlinkat(pending->directory_fd, name, 0) < 0) { status = -errno; goto out; }
+		status = notify_extensions(tracee, LINK2SYMLINK_UNLINK, (intptr_t) final, 0);
+	} else {
+		strcpy(replacement, final);
+		sprintf(replacement + strlen(replacement) - 4, "%04d", count - 1);
+		new_name = removal_entry(pending, replacement);
+		if (renameat(pending->directory_fd, name, pending->directory_fd, new_name) < 0 ||
+		    unlinkat(pending->directory_fd, pending->intermediate, 0) < 0 ||
+		    symlinkat(replacement, pending->directory_fd, pending->intermediate) < 0) {
+			status = -errno; goto out;
+		}
+		status = notify_extensions(tracee, LINK2SYMLINK_RENAME, (intptr_t) final, (intptr_t) replacement);
+	}
+out:
+	talloc_free(pending);
+	return status;
 }
 
 
