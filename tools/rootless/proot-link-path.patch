+/* A deletion is accounted only after the kernel actually removed this alias.
+ * Keep descriptors, not just names: another tracee can rename its parent or
+ * replace an alias while this syscall is in flight.  The descriptors also
+ * prevent inode reuse from making a different file look like the snapshot. */
+typedef struct PendingRemoval {
+	struct PendingRemoval *next;
+	pid_t owner;
+	int alias_fd, backing_fd, directory_fd;
+	bool accounted;
+	char intermediate[PATH_MAX];
+	char directory[PATH_MAX];
+	struct stat alias, backing;
+} PendingRemoval;
+
+static PendingRemoval *pending_removals;
+
+static int release_removal(PendingRemoval *pending)
+{
+	PendingRemoval **cursor = &pending_removals;
+	while (*cursor != NULL && *cursor != pending)
+		cursor = &(*cursor)->next;
+	if (*cursor == pending)
+		*cursor = pending->next;
+	if (pending->alias_fd >= 0) close(pending->alias_fd);
+	if (pending->backing_fd >= 0) close(pending->backing_fd);
+	if (pending->directory_fd >= 0) close(pending->directory_fd);
+	return 0;
+}
+
+static bool same_inode(const struct stat *left, const struct stat *right)
+{
+	return left->st_dev == right->st_dev && left->st_ino == right->st_ino;
+}
+
+/* Accept only this backing store's direct entries.  Never follow a modified
+ * intermediate into a new directory, including a guest-controlled symlink. */
+static const char *removal_entry(PendingRemoval *pending, const char *path)
+{
+	size_t length = strlen(pending->directory);
+	if (strncmp(path, pending->directory, length) != 0 || path[length] != '/')
+		return NULL;
+	path += length + 1;
+	return path[0] != '\0' && strchr(path, '/') == NULL ? path : NULL;
+}
+
+static int capture_removal(Extension *extension, Reg argument)
+{
+	Tracee *tracee = TRACEE(extension);
+	Link2SymlinkConfig *config;
+	PendingRemoval *pending;
+	struct stat candidate;
+	char path[PATH_MAX], intermediate[PATH_MAX], final[PATH_MAX];
+	const char *name;
+	char *slash;
+	int directory_fd, status;
+	ssize_t length;
+
+	status = read_path(tracee, path, peek_reg(tracee, CURRENT, argument));
+	if (status < 0) return status;
+	/* Ordinary files need no bookkeeping.  Recheck through the pinned FD
+	 * below before relying on this hint for a symlink candidate. */
+	if (lstat(path, &candidate) < 0 || !S_ISLNK(candidate.st_mode)) return 0;
+	config = get_config(extension, true);
+	if (config == NULL) return -ENOMEM;
+	pending = talloc_zero(config, PendingRemoval);
+	if (pending == NULL) return -ENOMEM;
+	pending->alias_fd = pending->backing_fd = pending->directory_fd = -1;
+	pending->next = pending_removals;
+	pending_removals = pending;
+	talloc_set_destructor(pending, release_removal);
+	pending->owner = tracee->pid;
+	pending->alias_fd = open(path, O_PATH | O_NOFOLLOW | O_CLOEXEC);
+	if (pending->alias_fd < 0 || fstat(pending->alias_fd, &pending->alias) < 0 ||
+	    !S_ISLNK(pending->alias.st_mode)) goto skip;
+	length = readlinkat(pending->alias_fd, "", intermediate, sizeof(intermediate) - 1);
+	if (length <= 0 || length >= (ssize_t)sizeof(intermediate) - 1) goto skip;
+	intermediate[length] = '\0';
+	slash = strrchr(intermediate, '/');
+	if (slash == NULL || strncmp(slash + 1, PREFIX, strlen(PREFIX)) != 0) goto skip;
+	strcpy(pending->intermediate, slash + 1);
+	memcpy(pending->directory, intermediate, slash - intermediate);
+	pending->directory[slash - intermediate] = '\0';
+	if (l2s_entry(intermediate, &directory_fd, &name) < 0) goto skip;
+	pending->directory_fd = directory_fd < 0
+		? open(pending->directory, O_PATH | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)
+		: fcntl(directory_fd, F_DUPFD_CLOEXEC, 0);
+	if (pending->directory_fd < 0) goto skip;
+	length = readlinkat(pending->directory_fd, pending->intermediate, final, sizeof(final) - 1);
+	if (length <= 0 || length >= (ssize_t)sizeof(final) - 1) goto skip;
+	final[length] = '\0';
+	name = removal_entry(pending, final);
+	if (name == NULL || !is_l2s_file(final)) goto skip;
+	pending->backing_fd = openat(pending->directory_fd, name, O_PATH | O_NOFOLLOW | O_CLOEXEC);
+	if (pending->backing_fd < 0 || fstat(pending->backing_fd, &pending->backing) < 0 ||
+	    !S_ISREG(pending->backing.st_mode)) goto skip;
+	config->removal = pending;
+	return 0;
+skip:
+	talloc_free(pending);
+	return 0;
+}
