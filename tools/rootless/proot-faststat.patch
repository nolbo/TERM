+			BPF_JUMP(BPF_JMP+BPF_JEQ+BPF_K, AUDIT_ARCH_AARCH64, 0, 10),
+			BPF_STMT(BPF_LD+BPF_W+BPF_ABS, offsetof(struct seccomp_data, instruction_pointer)+4),
+			BPF_JUMP(BPF_JMP+BPF_JEQ+BPF_K, (uint32_t)(PROOT_FASTSTAT_PC >> 32), 0, 8),
+			BPF_STMT(BPF_LD+BPF_W+BPF_ABS, offsetof(struct seccomp_data, instruction_pointer)),
+			BPF_JUMP(BPF_JMP+BPF_JEQ+BPF_K, (uint32_t)PROOT_FASTSTAT_PC, 0, 6),
+			BPF_STMT(BPF_LD+BPF_W+BPF_ABS, offsetof(struct seccomp_data, nr)),
+			BPF_JUMP(BPF_JMP+BPF_JEQ+BPF_K, 437 /* openat2 */, 3, 0),
+			BPF_JUMP(BPF_JMP+BPF_JEQ+BPF_K, 80 /* fstat */, 2, 0),
+			BPF_JUMP(BPF_JMP+BPF_JEQ+BPF_K, 57 /* close */, 1, 0),
+			BPF_STMT(BPF_JMP+BPF_JA+BPF_K, 1),
+			BPF_STMT(BPF_RET+BPF_K, SECCOMP_RET_ALLOW),
+		};
+		status = add_statements(&program, sizeof(fast)/sizeof(fast[0]), fast);
