+/* Resolve a plain lexical binding once, then let the kernel check every
+ * component. No filesystem metadata or cwd/binding state survives this call. */
+static bool kernel_stat_entry(Tracee *tracee)
+{
+	const char *setting = getenv("PROOT_STAT_KERNEL");
+	if (!setting || strcmp(setting, "1") != 0 || !stat_entry_eligible(tracee)) return false;
+	char input[PATH_MAX], path[PATH_MAX], cwd[PATH_MAX];
+	if (get_sysarg_path(tracee, input, SYSARG_2) <= 0) return false;
+	if (input[0] == '/') strcpy(path, input);
+	else {
+		if ((int)peek_reg(tracee, ORIGINAL, SYSARG_1) != AT_FDCWD ||
+		    getcwd2(tracee, cwd) < 0 || join_paths(2, path, cwd, input) < 0) return false;
+	}
+	/* Bind selection must see the same lexical components as the kernel.
+	 * Dot components, duplicate slashes and symlinks use PRoot's resolver. */
+	for (const char *part = path + 1; *part;) {
+		const char *slash = strchr(part, '/');
+		size_t length = slash ? (size_t)(slash - part) : strlen(part);
+		if (length == 0 || (length == 1 && part[0] == '.') ||
+		    (length == 2 && part[0] == '.' && part[1] == '.')) return false;
+		if (!slash) break;
+		part = slash + 1;
+	}
+	/* A nested binding can hide a symlink in its guest-side ancestors.
+	 * The full resolver must decide those cases before applying the bind. */
+	Binding *binding;
+	CIRCLEQ_FOREACH(binding, tracee->fs->bindings.guest, link.guest) {
+		if (strchr(binding->guest.path + 1, '/') != NULL) {
+			Comparison relation = compare_paths(binding->guest.path, path);
+			if (relation == PATHS_ARE_EQUAL || relation == PATH1_IS_PREFIX) return false;
+		}
+	}
+	if (stat_entry_special(path) || substitute_binding(tracee, GUEST, path) < 0 ||
+	    stat_entry_special(path)) return false;
+	struct proot_open_how how = { .flags = O_PATH | O_CLOEXEC,
+		.resolve = 0x04 /* RESOLVE_NO_SYMLINKS */ };
+	int fd = syscall(437 /* AArch64 openat2 */, AT_FDCWD, path, &how, sizeof(how));
+	if (fd < 0) return false;
+	struct stat result = {0};
+	int status = fstat(fd, &result);
+	close(fd);
+	if (status < 0) return false;
+	return emit_stat_entry(tracee, &result);
+}
