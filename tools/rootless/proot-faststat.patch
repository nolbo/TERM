+static bool stat_entry_special(const char *path)
+{
+	return strcmp(path, "/proc") == 0 || strncmp(path, "/proc/", 6) == 0 ||
+	    strcmp(path, "/sys") == 0 || strncmp(path, "/sys/", 5) == 0 ||
+	    strcmp(path, "/dev") == 0 || strncmp(path, "/dev/", 5) == 0;
