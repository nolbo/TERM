+/* Context mode preserves PRoot's current cwd/bind/identity decisions. A
+ * request is read once and its output is bounded; no guest state is cached. */
+static int faststat_resolve(Tracee *tracee)
+{
+	struct proot_faststat_context context;
+	word_t address = peek_reg(tracee, CURRENT, SYSARG_2);
+	char translated[PATH_MAX];
+	int status;
+	if (tracee->seccomp != ENABLED ||
+	    peek_reg(tracee, CURRENT, SYSARG_3) != sizeof(context) ||
+	    peek_reg(tracee, CURRENT, SYSARG_4) != PROOT_FASTSTAT_CONTEXT_VERSION)
+		return -EOPNOTSUPP;
+	status = read_data(tracee, &context, address, sizeof(context));
+	if (status < 0) return status;
+	if (!memchr(context.path, '\0', sizeof(context.path)) || !context.path[0] ||
+	    (context.flags != 0 && context.flags != AT_SYMLINK_NOFOLLOW))
+		return -EOPNOTSUPP;
+	struct faststat_path_cache cache;
+	cache.count = 0;
+	cache.missing_final[0] = '\0';
+	/* Diagnostic A/B switch; the default is request-local reuse. */
+	const char *reuse = getenv("PROOT_FASTSTAT_PATH_REUSE");
+	cache.reuse_directories = !(reuse && strcmp(reuse, "0") == 0);
+	tracee->faststat_path_cache = &cache;
+	status = translate_path(tracee, translated, context.dirfd, context.path,
+		context.flags != AT_SYMLINK_NOFOLLOW);
+	tracee->faststat_path_cache = NULL;
+	if (status < 0) return status;
+	/* Match l2s's validated backing basename (.NNNN suffix). Do not cache:
+	 * link/unlink renames the backing object as its virtual count changes. */
+	context.emulated_nlink = 0;
+	const char *hidden = strstr(translated, "/.l2s.");
+	if (strstr(translated, "/.proot.l2s.")) return -EOPNOTSUPP;
+	if (hidden != NULL) {
+		if (get_extension(tracee, link2symlink_callback) == NULL ||
+		    hidden != strrchr(translated, '/')) return -EOPNOTSUPP;
+		size_t length = strlen(hidden);
+		if (length < sizeof("/.l2s.") - 1 + 5 || hidden[length - 5] != '.')
+			return -EOPNOTSUPP;
+		for (size_t i = length - 4; i < length; i++) {
+			if (hidden[i] < '0' || hidden[i] > '9') return -EOPNOTSUPP;
+			context.emulated_nlink = context.emulated_nlink * 10 + hidden[i] - '0';
+		}
+		if (context.emulated_nlink == 0) return -EOPNOTSUPP;
+	}
+	/* Special kernel pseudo files retain the full compatibility path. */
+	if (strcmp(translated, "/proc") == 0 || strncmp(translated, "/proc/", 6) == 0 ||
+	    strcmp(translated, "/sys") == 0 || strncmp(translated, "/sys/", 5) == 0 ||
+	    strcmp(translated, "/dev") == 0 || strncmp(translated, "/dev/", 5) == 0)
+		return -EOPNOTSUPP;
+	const char *negative = getenv("PROOT_FASTSTAT_NEGATIVE");
+	context.result_errno = !context.emulated_nlink &&
+		!(negative && strcmp(negative, "0") == 0) &&
+		strcmp(cache.missing_final, translated) == 0 ? ENOENT : 0;
+	memset(context.path, 0, sizeof(context.path));
+	strcpy(context.path, translated);
