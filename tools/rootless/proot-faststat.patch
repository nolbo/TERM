+static bool stat_entry_eligible(Tracee *tracee, bool emulated)
+{
+	if (tracee->seccomp != ENABLED || is_32on64_mode(tracee) ||
+	    (get_sysnum(tracee, ORIGINAL) != PR_newfstatat &&
