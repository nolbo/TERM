+/* Only for service-owned helpers: stdin is the owner's pipe, not a PTY.
+ * Watch HUP without consuming input. Start after EXITKILL is installed. */
+static void *watch_owner_pipe(void *opaque)
+{
+	int fd = (int)(intptr_t)opaque;
+	struct pollfd owner = { .fd = fd, .events = 0 };
+	while (poll(&owner, 1, -1) < 0 && errno == EINTR) {}
+	close(fd);
+	kill(getpid(), SIGKILL);
+	return NULL;
+}
+
+static int start_owner_pipe_watch(void)
+{
+	struct stat st;
+	pthread_t thread;
+	if (fstat(STDIN_FILENO, &st) < 0) return -errno;
+	if (!S_ISFIFO(st.st_mode)) return -EINVAL;
+	int fd = fcntl(STDIN_FILENO, F_DUPFD_CLOEXEC, 3);
+	if (fd < 0) return -errno;
+	struct pollfd owner = { .fd = fd, .events = 0 };
+	int ready;
+	do { ready = poll(&owner, 1, 0); } while (ready < 0 && errno == EINTR);
+	if (ready != 0) {
+		int error = ready < 0 ? errno : EPIPE;
+		close(fd);
+		return -error;
+	}
+	int result = pthread_create(&thread, NULL, watch_owner_pipe, (void *)(intptr_t)fd);
+	if (result) { close(fd); return -result; }
+	result = pthread_detach(thread);
+	return -result;
+}
