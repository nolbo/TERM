+
+static bool emit_stat_entry(Tracee *tracee, struct stat *result)
+{
+	_Static_assert(sizeof(*result) == 128, "AArch64 guest stat ABI");
+	_Static_assert(offsetof(struct stat, st_uid) == 24, "AArch64 guest uid ABI");
+	if (!S_ISREG(result->st_mode) && !S_ISDIR(result->st_mode))
+		return false;
+	Extension *identity = get_extension(tracee, fake_id0_callback);
+	if (identity) {
+		Config *config = (Config *)identity->config;
+		if (result->st_uid == getuid()) result->st_uid = config->suid;
+		if (result->st_gid == getgid()) result->st_gid = config->sgid;
+	}
+	/* PTRACE_POKEDATA can write a read-only guest mapping. A syscall result
+	 * must instead respect its protections and fall back on short writes. */
+	struct iovec local = { result, sizeof(*result) };
+	Reg destination = get_sysnum(tracee, ORIGINAL) == PR_fstat ? SYSARG_2 : SYSARG_3;
+	struct iovec remote = { (void *)peek_reg(tracee, ORIGINAL, destination), sizeof(*result) };
+	proot_perf_count(PERF_VM_WRITE);
+	if (process_vm_writev(tracee->pid, &local, 1, &remote, 1, 0) != sizeof(*result))
+		return false;
+	poke_reg(tracee, SYSARG_RESULT, 0);
+	set_sysnum(tracee, PR_void);
+	tracee->sysexit_pending = false;
+	tracee->restart_how = PTRACE_CONT;
+	return true;
+}
