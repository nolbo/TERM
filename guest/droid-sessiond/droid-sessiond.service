[Unit]
Description=TERM persistent session daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/lib/droid-terminal/droid-sessiond
Restart=on-failure
RestartSec=2
User=droid
# Interactive guest shells need setuid sudo for Debian package management.
NoNewPrivileges=no
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
