package dev.terminal.runtime.ipc;

import dev.terminal.runtime.ipc.IRuntimeStateListener;
import dev.terminal.runtime.ipc.ITerminalStateListener;
import dev.terminal.runtime.ipc.IAvfImageInitializationCallback;

interface IRuntimeService {
    String getStorageJson();
    long measureStorage(String runtimeType, String storageId);
    String deleteStorage(String runtimeType, String storageId);
    String getState();
    String getDetail();
    String getImageStatus();
    String getRuntimeStatusJson();
    String getSessionsJson();
    String getForwardedPortsJson();
    String getWakePolicy();
    String getCapabilityGrant(String capability);
    void prepare();
    void startRuntime();
    void stopRuntime(int mode);
    void createSessionFromSpec(String launchSpecJson, int rows, int cols);
    void createSession(String runtimeType, String shell, String cwd, int rows, int cols);
    void attachSession(String sessionId);
    void attachTerminal(String sessionId, ITerminalStateListener listener, int rows, int cols, int cellWidth, int cellHeight, String paletteJson);
    void detachTerminal(String sessionId, ITerminalStateListener listener);
    void configureTerminal(String sessionId, int rows, int cols, int cellWidth, int cellHeight, String paletteJson);
    void setTerminalViewport(String sessionId, int row, float offset, long transcriptShift);
    void detachSession(String sessionId);
    void writeSessionInput(String sessionId, in byte[] bytes);
    void resizeSession(String sessionId, int rows, int cols);
    void renameSession(String sessionId, String title);
    void terminateSession(String sessionId);
    void setWakePolicy(String policy);
    void setAvfSettings(int memoryMib, int cpuCount, boolean protectedVm, boolean enableNetwork);
    void setNativeSessionSettings(String terminalType, boolean loginShell);
    void prepareRootless(String runtimeType);
    void setCapabilityGrant(String capability, String grant);
    void registerListener(IRuntimeStateListener listener);
    void unregisterListener(IRuntimeStateListener listener);
    void setKittyGraphicsCompatibility(boolean enabled);
    void setKittyRemoteControl(boolean enabled);
    void removeRootless(String runtimeType, boolean removeHome);
    String getUsbStateJson();
    String approveUsbRequest(String requestId);
    void denyUsbRequest(String requestId);
    void revokeUsbSession(String sessionId);
    String addUsbStorageTree(String uri, int flags);
    void removeUsbStorageTree(String id);
    String getHostToolOperationsJson();
    String submitHostToolInput(String operationId, String promptNonce, in String[] values);
    void cancelHostToolOperation(String operationId);
    void migrateRootlessToNative(String runtimeType);
    void setSessionTaskNotifications(boolean enabled);
    String getSessionMemoryJson();
    String renameStorage(String runtimeType, String storageId, String name);
    String measureStorageUsageJson(String runtimeType, String storageId);
    void createSessionFromSpecWithRequestId(String launchSpecJson, String requestId, int rows, int cols);
    String getEnvironmentsJson();
    String measureEnvironmentUsageJson(String environmentId);
    String renameEnvironment(String environmentId, String name);
    String deleteEnvironment(String environmentId);
    String operateEnvironment(String environmentId, String operation);
    String getEnvironmentSoftwareJson(String environmentId);
    String getUserspaceLinuxSettingsJson();
    String setUserspaceLinuxDns(String mode, String servers);
    boolean cancelRootlessInstallation(String runtimeType, String storageId);
    void createSessionFromSpecWithInstallationConsent(String launchSpecJson, String requestId, int rows, int cols);
    void initializeAvfImage(String storageId, String requestId, IAvfImageInitializationCallback callback);
    void cancelAvfImageInitialization(String requestId);
    void setSessionNotificationFocus(@nullable String sessionId, IRuntimeStateListener listener);
}
