<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!--
          This service deliberately lives outside the UI process. stopWithTask is
          false because task removal must detach the UI, never terminate a VM.
        -->
        <service
            android:name=".lifecycle.VmRuntimeService"
            android:exported="false"
            android:process=":vmhost"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Owns user-started persistent terminal PTYs and optional Rootless or AVF Linux runtimes." />
        </service>
    </application>
</manifest>
