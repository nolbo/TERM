[Unit]
Description=Factory-only private share filesystem probe
ConditionKernelCommandLine=term.share-selftest=1
Requires=term-shares.service
After=term-shares.service
Before=droid-sessiond.service

[Service]
Type=oneshot
User=droid
Group=droid
NoNewPrivileges=yes
ExecStart=/usr/bin/python3 /usr/local/lib/droid/image-share-selftest.py
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
