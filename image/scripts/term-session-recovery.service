[Unit]
Description=TERM resumable host-only session transport
After=droid-sessiond.service
Requires=droid-sessiond.service

[Service]
ExecStart=/usr/local/lib/droid/droid-sessiond --session-recovery
Restart=on-failure
RestartSec=2
User=root
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
