#!/bin/sh
set -eu
# Executed as PID 1 by the producer's QEMU smoke test, never normal AVF boot.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev || true
# Normal boot gets localhost from systemd.hostname; this PID 1 bypasses systemd.
printf 'localhost\n' > /proc/sys/kernel/hostname
grep -q ' / overlay ' /proc/mounts
grep ' /.droid/lower ext4 ' /proc/mounts | grep -q 'ro,'
mount -t ext4 -o ro,nodev,nosuid,noexec /dev/vdc /etc/droid-config
grep -q '^stateDevice=/dev/vdb$' /etc/droid-config/runtime.properties
test -x /usr/local/lib/droid/droid-sessiond
test -x /usr/local/lib/droid/droid-agent
test -x /usr/local/lib/droid/droid-port-agent
test -x /usr/local/bin/droid
id droid
/usr/local/lib/droid/droid-sessiond --self-check
test "$(readlink /etc/resolv.conf)" = /run/systemd/resolve/stub-resolv.conf
grep -qx 'Driver=virtio_net' /etc/systemd/network/10-term-virtio.network
grep -qx 'DHCP=yes' /etc/systemd/network/10-term-virtio.network
for service in systemd-networkd systemd-resolved; do
  test -x "/usr/lib/systemd/$service"
  systemctl --root=/ is-enabled --quiet "$service.service"
done
echo TERM_AVF_NETWORK_CONFIG_OK
modprobe virtiofs
test "$(id -u droid)" -eq 1000
test -x /usr/local/lib/droid/mount-shared-directories.sh
systemctl --root=/ is-enabled --quiet term-shares.service
grep -qx 'Requires=term-shares.service' /etc/systemd/system/droid-sessiond.service.d/shares.conf
/usr/local/lib/droid/mount-shared-directories.sh
echo TERM_AVF_VIRTIOFS_CONFIG_OK
if [ -d /.droid/lower/var/lib/apt/lists ]; then
  if find /.droid/lower/var/lib/apt/lists -type f ! -name '*_Release' ! -name '*_Release.gpg' ! -name '*_InRelease' ! -name lock -print -quit | grep -q .; then
    echo 'Sealed image contains stale APT indexes' >&2
    exit 1
  fi
fi
test ! -e /.droid/lower/var/cache/apt/pkgcache.bin
test ! -e /.droid/lower/var/cache/apt/srcpkgcache.bin
test ! -e /.droid/lower/var/lib/droid/apt-initialization/complete
test -x /usr/local/lib/droid/initialize-avf-apt.sh
systemctl --root=/ is-enabled --quiet droid-apt-init.service
echo TERM_AVF_APT_BASE_CLEAN_OK
/usr/local/lib/droid/image-user-selftest
mkdir -p /var/lib/droid-image-test
if [ -e /var/lib/droid-image-test/persistent ]; then
  test "$(cat /var/lib/droid-image-test/persistent)" = survives-reboot
  echo TERM_AVF_PERSISTENCE_OK
else
  printf 'survives-reboot\n' > /var/lib/droid-image-test/persistent
  echo TERM_AVF_FIRST_BOOT_OK
fi
sync
poweroff -f
