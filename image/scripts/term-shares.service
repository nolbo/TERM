[Unit]
Description=Mount connected TERM shared directories
After=local-fs.target
Requires=term-share-broker.service
After=term-share-broker.service
Before=droid-sessiond.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/droid/mount-shared-directories.sh
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
