<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <dev.terminal.app.ui.SignalAppBar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:barNavigationIcon="@drawable/ic_arrow_back" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/space_5">
            <TextView android:id="@+id/description" style="@style/Text.TerminalGrid.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_5" android:layout_marginTop="@dimen/space_3" />
            <LinearLayout android:id="@+id/settings_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
