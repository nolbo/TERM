<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/grid_base" android:orientation="vertical" android:padding="@dimen/space_5">
    <TextView style="@style/Text.TerminalGrid.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LINUX ENVIRONMENT" />
    <TextView style="@style/Text.TerminalGrid.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="Rootless Debian" />
    <TextView style="@style/Text.TerminalGrid.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="권한, ADB, 별도 파일 없이 Debian과 공식 apt를 준비합니다." android:textColor="@color/grid_text_secondary" />
    <LinearLayout style="@style/Panel.TerminalGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_5" android:orientation="vertical" android:padding="@dimen/space_4">
        <TextView android:id="@+id/setup_status" style="@style/Text.TerminalGrid.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="설치 준비 중" />
        <TextView android:id="@+id/setup_detail" style="@style/Text.TerminalGrid.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="검증된 Debian 이미지를 내려받고 있습니다. 처음 한 번만 필요합니다." />
        <ProgressBar android:id="@+id/setup_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:indeterminate="true" android:indeterminateTint="@color/grid_signal" />
    </LinearLayout>
    <TextView style="@style/Text.TerminalGrid.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:text="최소 700 MiB의 여유 공간과 인터넷 연결이 필요합니다. 이 창을 닫아도 설치 작업은 백그라운드 런타임에서 계속됩니다." />
    <Button android:id="@+id/setup_retry" style="@style/Widget.TerminalGrid.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="다시 시도" android:visibility="gone" />
    <Button android:id="@+id/setup_close" style="@style/Widget.TerminalGrid.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="닫기" />
</LinearLayout>
