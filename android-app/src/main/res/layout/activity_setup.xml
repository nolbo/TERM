<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <dev.terminal.app.ui.SignalAppBar android:layout_width="match_parent" android:layout_height="wrap_content" app:barTitle="Droid Terminal" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="@dimen/space_5" android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_6">
            <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_grid_icon_well">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_terminal" />
            </FrameLayout>
            <TextView style="@style/Text.TerminalGrid.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6" android:text="초기 설정" />
            <TextView style="@style/Text.TerminalGrid.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:gravity="center" android:text="바로 쓰는 Linux 터미널" />
            <TextView style="@style/Text.TerminalGrid.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:gravity="center" android:text="Android Native 셸은 즉시 시작합니다. Rootless Debian은 추가 권한 없이 공식 apt 환경을 제공하며, AVF는 지원되는 특권 제품 빌드의 선택적 가속 환경입니다." android:textColor="@color/grid_text_secondary" />
            <LinearLayout style="@style/Panel.TerminalGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:orientation="vertical" android:padding="@dimen/space_4">
                <TextView style="@style/Text.TerminalGrid.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="시작 구성" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="@dimen/space_3" android:background="@color/grid_line" />
                <TextView style="@style/Text.TerminalGrid.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="6dp" android:text="[01] Android Native · 즉시 실행\n[02] Rootless Debian · 권한 없는 apt/glibc\n[03] AVF Debian · 선택적 실제 커널\n[04] UI와 독립된 영구 PTY 세션" android:textColor="@color/grid_text_secondary" />
            </LinearLayout>
            <Button android:id="@+id/automatic_setup_button" style="@style/Widget.TerminalGrid.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6" android:text="터미널 시작" />
            <Button android:id="@+id/local_image_button" style="@style/Widget.TerminalGrid.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="Debian 이미지 선택" />
            <TextView style="@style/Text.TerminalGrid.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:gravity="center" android:text="로컬 이미지 선택은 AVF 전용입니다. Rootless Debian은 별도 rootfs를 사용합니다." />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
