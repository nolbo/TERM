<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <dev.terminal.app.ui.SignalAppBar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:barNavigationIcon="@drawable/ic_arrow_back" app:barTitle="상태 및 진단" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/space_3" android:paddingBottom="@dimen/space_6">
            <TextView style="@style/Text.TerminalGrid.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_2" android:layout_marginTop="@dimen/space_3" android:text="런타임, 이미지, 세션과 포트 전달의 현재 상태를 읽기 전용으로 표시합니다." />
            <TextView style="@style/Text.TerminalGrid.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_2" android:layout_marginTop="@dimen/space_6" android:text="실시간 상태" />
            <FrameLayout style="@style/Panel.TerminalGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2">
                <TextView android:id="@+id/diagnostics_text" style="@style/Text.TerminalGrid.Report" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/space_4" android:textIsSelectable="true" />
            </FrameLayout>
            <TextView style="@style/Text.TerminalGrid.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_2" android:layout_marginTop="@dimen/space_3" android:text="오류가 있으면 ‘상세’ 항목부터 확인하세요. 이 화면은 런타임 상태를 변경하지 않습니다." />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
