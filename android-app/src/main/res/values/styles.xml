<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DroidTerminal" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/grid_base</item>
        <item name="android:colorAccent">@color/grid_signal</item>
        <item name="colorAccent">@color/grid_signal</item>
        <item name="android:textColorPrimary">@color/grid_text</item>
        <item name="android:textColorSecondary">@color/grid_text_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/grid_base</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Text.TerminalGrid.AppBar" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/grid_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.TerminalGrid.Display" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/grid_text</item>
    </style>

    <style name="Text.TerminalGrid.Title" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/grid_text</item>
    </style>

    <style name="Text.TerminalGrid.Body" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/grid_text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.TerminalGrid.Caption" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/grid_text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.TerminalGrid.Label" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/grid_signal</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Text.TerminalGrid.Report" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/grid_text</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Widget.TerminalGrid.Button.Primary" parent="">
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_grid_action_primary</item>
        <item name="android:textColor">@color/grid_on_signal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="Widget.TerminalGrid.Button.Secondary" parent="">
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_grid_action_secondary</item>
        <item name="android:textColor">@color/grid_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="Widget.TerminalGrid.IconButton" parent="">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_grid_icon_button</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="Widget.TerminalGrid.Key" parent="">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@drawable/bg_grid_key</item>
        <item name="android:textColor">@color/grid_key_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="Panel.TerminalGrid" parent="">
        <item name="android:background">@drawable/bg_grid_panel</item>
    </style>
</resources>
