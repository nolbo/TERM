    <string name="delete">삭제</string>
    <string name="workspaces_title">Workspaces</string>
    <string name="workspaces_summary">Workspace는 파일 폴더와 독립적인 세션 그룹입니다. 전환하거나 삭제해도 세션과 실행환경은 계속 유지됩니다.</string>
    <string name="workspace_all">모든 세션</string>
