    <string name="workspace_launches">실행 구성</string>
    <string name="workspace_startup_launches">시작 시 실행</string>
    <string name="workspace_startup_launches_summary">세션이 없는 워크스페이스를 열 때 선택한 실행 구성을 순서대로 시작합니다. 여러 개를 선택할 수 있습니다.</string>
