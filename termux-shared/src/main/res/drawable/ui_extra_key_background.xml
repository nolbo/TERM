<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle">
        <corners android:radius="6dp" /><solid android:color="@color/ui_surface_active" />
    </shape></item>
    <item android:state_activated="true"><shape android:shape="rectangle">
        <corners android:radius="6dp" /><solid android:color="@color/ui_surface_active" />
        <stroke android:width="1dp" android:color="@color/ui_text_muted" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <corners android:radius="6dp" /><solid android:color="@color/ui_surface_raised" />
        <stroke android:width="1dp" android:color="@color/ui_border" />
    </shape></item>
</selector>
